# ============================================================
# TEMPLATE .env UNTUK PRODUKSI — SPKM
# Salin ke .env di pelayan produksi, isi nilai sebenar, JANGAN commit .env sebenar.
# Selepas set: php artisan key:generate (jika APP_KEY kosong) && php artisan config:cache
# ============================================================

APP_NAME=SPKM
APP_ENV=production
APP_KEY=
# WAJIB false di produksi — true membocorkan stack trace/konfigurasi ke pengguna & klien API
APP_DEBUG=false
APP_URL=https://DOMAIN-ANDA
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Produksi: warning/error (bukan debug)
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sppkms
# Guna pengguna DB khusus (BUKAN root) dengan kata laluan kukuh
DB_USERNAME=sppkms_app
DB_PASSWORD=GANTI_KATA_LALUAN_KUKUH

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true di bawah HTTPS — kuki sesi tidak dihantar atas HTTP biasa
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=700

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@DOMAIN-ANDA"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== SPPKMS =====
SPKM_MASJID_ID=49
SPPKMS_LEGACY_URL=https://spm.mesrasuci.com
DUALWRITE_VERIFY=true

# Isi SEBELUM aktif webhook Telegram (kosong = handler tolak semua / ciri mati)
TELEGRAM_WEBHOOK_SECRET=GANTI_SECRET_RAWAK_PANJANG

# Backup Google Drive
MYSQLDUMP_PATH=mysqldump
GDRIVE_SA_JSON_PATH=/laluan/selamat/service-account.json
